<Window x:Class="oaiResponsesAvalonia.Views.EnvironmentReportWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:oaiResponsesAvalonia.Services"
        Title="Developer Environment Report"
        Width="760"
        Height="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="Environment and workspace capabilities" />
        <TextBox x:Name="ReportTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />
        <StackPanel x:Name="WorkspaceTreeSection"
                    Grid.Row="2"
                    Margin="0,10,0,0">
            <TextBlock Margin="0,0,0,4"
                       FontWeight="SemiBold"
                       Text="Workspace file tree (folders marked as skipped are not scanned)" />
            <TreeView x:Name="WorkspaceTreeView"
                      Height="320"
                      BorderThickness="1"
                      Background="WhiteSmoke"
                      BorderBrush="Gray"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <TreeView.DataTemplates>
                    <TreeDataTemplate DataType="services:WorkspaceTreeNode"
                                      x:DataType="services:WorkspaceTreeNode"
                                      ItemsSource="{Binding Children}">
                        <Border Background="GhostWhite"
                                HorizontalAlignment="Left"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="2 2 2 2"
                                BoxShadow="2 2 Gray"
                                Padding="1">
                            <TextBlock Text="{Binding Name}" />
                        </Border>
                    </TreeDataTemplate>
                </TreeView.DataTemplates>
            </TreeView>
        </StackPanel>
        <Button Grid.Row="3"
                Width="90"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Click="Close_Click"
                Content="Close" />
    </Grid>
</Window>
